  {"id": "merge-lines", "request": "`placeOrder` treats several lines for the same sku as one line with the summed quantity: the stock check uses the sum, and the stored order has one line per sku, in order of first appearance.", "giz": [["export function placeOrder(store: Store, customer: string, lines: Vec<Line>): Result<Store, string> effects {fail} {\n    if (lines.length === 0) { return Result.err(\"an order needs lines\"); }", "export function placeOrder(store: Store, customer: string, requested: Vec<Line>): Result<Store, string> effects {fail} {\n    if (requested.length === 0) { return Result.err(\"an order needs lines\"); }\n    let lines: Vec<Line> = [];\n    for (const index of range(0, requested.length)) {\n        let found = -1;\n        for (const at of range(0, lines.length)) { if (lines[at].sku === requested[index].sku) { found = at; } }\n        if (found < 0) { lines.push(requested[index]); } else { lines[found] = Line(lines[found].sku, lines[found].quantity + requested[index].quantity); }\n    }"]], "ts": [["export function placeOrder(store: Store, customer: string, lines: Line[]): Result<Store, string> {\n    if (lines.length === 0) { return err(\"an order needs lines\"); }", "export function placeOrder(store: Store, customer: string, requested: Line[]): Result<Store, string> {\n    if (requested.length === 0) { return err(\"an order needs lines\"); }\n    const lines: Line[] = [];\n    for (const line of requested) {\n        const found = lines.findIndex((entry) => entry.sku === line.sku);\n        if (found < 0) { lines.push(line); } else { lines[found] = { sku: line.sku, quantity: lines[found].quantity + line.quantity }; }\n    }"]]},
  {"id": "on-hold", "request": "Orders whose amount due (`orderTotal`) is 500000 cents or more are placed on hold: a new status \"onHold\" (what `statusOf` returns), with the stock still reserved and the order still logged as \"placed <id>\". Add `release(store, id)` returning `Result<Store, string>`, which moves an on-hold order to placed and fails for any other order. An on-hold order can be cancelled like a placed one, but not shipped.", "giz": [["export type Status = | { kind: \"placed\"; } | { kind: \"shipped\"; } | { kind: \"cancelled\"; };", "export type Status = | { kind: \"placed\"; } | { kind: \"onHold\"; } | { kind: \"shipped\"; } | { kind: \"cancelled\"; };"], ["    for (const index of range(0, lines.length)) { next = adjust(next, lines[index].sku, 0 - lines[index].quantity); }\n", "    for (const index of range(0, lines.length)) { next = adjust(next, lines[index].sku, 0 - lines[index].quantity); }\n    if (orderTotal(next, id) >= 500000) { const at = findOrder(next, id); next = withOrder(next, at, withStatus(next.orders[at], Status.onHold())); }\n"], ["export function lastOrderId(store: Store): i64 { return store.nextId - 1; }", "export function lastOrderId(store: Store): i64 { return store.nextId - 1; }\nexport function release(store: Store, id: i64): Result<Store, string> effects {fail} {\n    const index = findOrder(store, id);\n    if (index < 0) { return Result.err(\"unknown order \" + string(id)); }\n    match (store.orders[index].status) {\n        Status.onHold() => { return Result.ok(withOrder(store, index, withStatus(store.orders[index], Status.placed()))); }\n        Status.placed() => { return Result.err(\"order \" + string(id) + \" is not on hold\"); }\n        Status.shipped() => { return Result.err(\"order \" + string(id) + \" is not on hold\"); }\n        Status.cancelled() => { return Result.err(\"order \" + string(id) + \" is not on hold\"); }\n    }\n}"], ["        Status.shipped() => { return Result.err(\"order \" + string(id) + \" already shipped\"); }\n        Status.cancelled() => { return Result.err(\"order \" + string(id) + \" is cancelled\"); }\n    }\n}\n// Cancel", "        Status.onHold() => { return Result.err(\"order \" + string(id) + \" is on hold\"); }\n        Status.shipped() => { return Result.err(\"order \" + string(id) + \" already shipped\"); }\n        Status.cancelled() => { return Result.err(\"order \" + string(id) + \" is cancelled\"); }\n    }\n}\n// Cancel"], ["    const order = store.orders[index];\n    match (order.status) {\n        Status.placed() => {\n            let next = withOrder(store, index, withStatus(order, Status.cancelled()));\n            for (const at of range(0, order.lines.length)) { next = adjust(next, order.lines[at].sku, order.lines[at].quantity); }\n            return Result.ok(automate(next, Event.orderCancelled(id)));\n        }", "    const order = store.orders[index];\n    match (order.status) {\n        Status.placed() => { return Result.ok(returnStock(store, index, order)); }\n        Status.onHold() => { return Result.ok(returnStock(store, index, order)); }"], ["export function subtotal(", "function returnStock(store: Store, index: i64, order: Order): Store effects {fail} {\n    let next = withOrder(store, index, withStatus(order, Status.cancelled()));\n    for (const at of range(0, order.lines.length)) { next = adjust(next, order.lines[at].sku, order.lines[at].quantity); }\n    return automate(next, Event.orderCancelled(order.id));\n}\nexport function subtotal("], ["        Status.placed() => { return \"placed\"; }\n", "        Status.placed() => { return \"placed\"; }\n        Status.onHold() => { return \"onHold\"; }\n"]], "ts": [["export type Status = { kind: \"placed\" } | { kind: \"shipped\" } | { kind: \"cancelled\" };", "export type Status = { kind: \"placed\" } | { kind: \"onHold\" } | { kind: \"shipped\" } | { kind: \"cancelled\" };"], ["    for (const line of lines) { next = adjust(next, line.sku, -line.quantity); }\n", "    for