  {"id": "vip-discount", "request": "Customers whose name starts with \"VIP-\" get 5% off the amount due (`orderTotal`), applied after the bulk discount and truncated to whole cents.", "giz": [["    const amount = subtotal(store, store.orders[index]);\n    if (amount >= BULK_CENTS) { return amount - amount * BULK_PERCENT / 100; }\n    return amount;", "    const amount = subtotal(store, store.orders[index]);\n    let due = amount;\n    if (amount >= BULK_CENTS) { due = amount - amount * BULK_PERCENT / 100; }\n    if (store.orders[index].customer.startsWith(\"VIP-\")) { due = due - due * 5 / 100; }\n    return due;"]], "ts": [["    const amount = subtotal(store, store.orders[index]);\n    if (amount >= BULK_CENTS) { return amount - Math.trunc(amount * BULK_PERCENT / 100); }\n    return amount;", "    const amount = subtotal(store, store.orders[index]);\n    let due = amount;\n    if (amount >= BULK_CENTS) { due = amount - Math.trunc(amount * BULK_PERCENT / 100); }\n    if (store.orders[index].customer.startsWith(\"VIP-\")) { due = due - Math.trunc(due * 5 / 100); }\n    return due;"]]},
  {"id": "restock", "request": "Add `restock(store, sku, quantity)` returning `Result<Store, string>`: it adds `quantity` to a known sku's stock as a stock change (logged and automated like any other), and fails for an unknown sku or a quantity that is not positive. Whenever a stock change leaves an item above its `reorderAt`, its open reorder work is closed.", "giz": [["// ----- Orders -----", "function closeWork(store: Store, kind: string, subject: string): Store effects {fail} {\n    let work = store.work;\n    for (const index of range(0, work.length)) {\n        if (work[index].open && work[index].kind === kind && work[index].subject === subject) { work[index] = Work(kind, subject, false); }\n    }\n    return Store(store.items, store.orders, work, store.log, store.nextId);\n}\nexport function restock(store: Store, sku: string, quantity: i64): Result<Store, string> effects {fail} {\n    if (quantity <= 0) { return Result.err(\"quantity must be positive for \" + sku); }\n    if (findItem(store, sku) < 0) { return Result.err(\"unknown sku \" + sku); }\n    return Result.ok(adjust(store, sku, quantity));\n}\n\n// ----- Orders -----"], ["            if (stock <= logged.items[index].reorderAt) { return openWork(logged, \"reorder\", sku); }\n            return logged;", "            if (stock <= logged.items[index].reorderAt) { return openWork(logged, \"reorder\", sku); }\n            return closeWork(logged, \"reorder\", sku);"]], "ts": [["// ----- Orders -----", "function closeWork(store: Store, kind: string, subject: string): Store {\n    return { ...store, work: store.work.map((entry) => (entry.open && entry.kind === kind && entry.subject === subject ? { ...entry, open: false } : entry)) };\n}\nexport function restock(store: Store, sku: string, quantity: number): Result<Store, string> {\n    if (quantity <= 0) { return err(\"quantity must be positive for \" + sku); }\n    if (findItem(store, sku) < 0) { return err(\"unknown sku \" + sku); }\n    return ok(adjust(