-- Representative queries over the HR sample schema, in the forms Oracle's documentation and
-- applications use them; every one orders its rows so the answer is deterministic.
select count(*) from employees;
select count(*), min(hire_date), max(hire_date), sum(salary), round(avg(salary), 2) from employees;
select region_id, region_name from regions order by region_id;
select country_id, country_name from countries where region_id = 1 order by country_id;
select employee_id, first_name || ' ' || last_name name, salary from employees where salary > 12000 order by salary desc, employee_id;
select e.last_name, d.department_name from employees e join departments d on e.department_id = d.department_id where d.department_id in (10, 20, 110) order by e.last_name;
select e.last_name, d.department_name from employees e, departments d where e.department_id = d.department_id(+) and e.employee_id in (178, 100) order by e.last_name;
select d.department_name, count(e.employee_id) from departments d left outer join employees e on e.department_id = d.department_id group by d.department_name having count(e.employee_id) > 5 order by 2 desc, 1;
select e.last_name, l.city, c.country_name from employees e join departments d using (department_id) join locations l using (location_id) join countries c using (country_id) where e.employee_id in (100, 145, 201) order by e.last_name;
select department_id, count(*), max(salary), min(salary) from employees group by department_id order by department_id nulls first;
select job_id, sum(salary) from employees group by job_id having sum(salary) > 30000 order by 2 desc;
select department_id, job_id, sum(salary) from employees where department_id in (20, 30) group by rollup (department_id, job_id) order by department_id, job_id;
select last_name, salary, department_id from employees e where salary > (select avg(salary) from employees where department_id = e.department_id) and department_id = 80 order by salary desc, last_name;
select last_name from employees where employee_id in (select manager_id from employees) order by last_name;
select department_name from departments d where not exists (select 1 from employees e where e.department_id = d.department_id) and department_id < 140 order by 1;
select last_name, job_id, salary from employees where salary = (select max(salary) from employees);
select employee_id, last_name, manager_id, level from employees start with manager_id is null connect by prior employee_id = manager_id and level <= 2 order by level, employee_id;
select lpad(' ', 2 * level - 2) || last_name org from employees where department_id = 90 start with employee_id = 100 connect by prior employee_id = manager_id order siblings by last_name;
select last_name, sys_connect_by_path(last_name, '/') path from employees where employee_id = 206 start with employee_id = 100 connect by prior employee_id = manager_id;
select last_name, salary, rank() over (partition by department_id order by salary desc) rnk from employees where department_id = 60 order by rnk, last_name;
select department_id, last_name, salary, sum(salary) over (partition by department_id order by employee_id) running from employees where department_id in (10, 20) order by department_id, employee_id;
select last_name, hire_date, lag(hire_date) over (order by hire_date, employee_id) prev from employees where department_id = 30 order by hire_date, employee_id;
select department_id, listagg(last_name, ', ') within group (order by last_name) names from employees where department_id in (10, 20, 30) group by department_id order by department_id;
select * from (select last_name, salary, row_number() over (order by salary desc, employee_id) rn from employees) where rn <= 5 order by rn;
select last_name, salary from employees order by salary desc, employee_id fetch first 5 rows only;
select last_name, salary from (select last_name, salary from employees order by salary desc, employee_id) where rownum <= 3;
select last_name, nvl(to_char(commission_pct), 'none') comm from employees where employee_id between 145 and 150 or employee_id = 100 order by employee_id;
select last_name, nvl2(commission_pct, salary * commission_pct, 0) bonus from employees where department_id = 80 and rownum <= 3 order by employee_id;
select last_name, decode(job_id, 'IT_PROG', 'Programmer', 'SA_MAN', 'Sales Manager', 'Other') role from employees where employee_id in (103, 145, 100) order by employee_id;
select last_name, case when salary < 5000 then 'Low' when salary < 10000 then 'Medium' else 'High' end band from employees where employee_id in (132, 103, 100) order by employee_id;
select to_char(hire_date, 'YYYY') yr, count(*) from employees group by to_char(hire_date, 'YYYY') order by yr;
select last_name, to_char(hire_date, 'DD-MON-YYYY') hired, months_between(date '2024-01-01', hire_date) > 200 veteran from employees where employee_id in (100, 101) order by employee_id;
select last_name, trunc(months_between(date '2024-01-01', hire_date) / 12) years from employees where employee_id in (100, 104) order by employee_id;
select last_name, add_months(hire_date, 6) review, last_day(hire_date) month_end from employees where employee_id = 107;
select upper(last_name), lower(email), initcap(job_id), length(last_name), substr(first_name, 1, 3), instr(last_name, 'a') from employees where employee_id = 101;
select last_name, round(salary / 12, 2) monthly, trunc(salary * 1.075) raised, mod(salary, 1000) rem from employees where employee_id in (100, 104) order by employee_id;
select * from emp_details_view where employee_id = 100;
select count(*) from emp_details_view where region_name = 'Americas';
select job_id, job_title, min_salary, max_salary from jobs where max_salary > 15000 order by job_id;
select employee_id, start_date, end_date, job_id from job_history order by employee_id, start_date;
select e.last_name, j.job_title, jh.start_date from employees e join job_history jh on e.employee_id = jh.employee_id join jobs j on j.job_id = jh.job_id order by e.last_name, jh.start_date;
select department_id from employees where department_id is not null union select department_id from departments where location_id = 1700 order by 1;
select job_id from employees where department_id = 50 intersect select job_id from employees where department_id = 80 order by 1;
select job_id from jobs minus select job_id from employees order by 1;
select employees_seq.nextval from dual;
insert into departments (department_id, department_name, location_id) values (departments_seq.nextval, 'Analytics', 1700);
select department_id, department_name from departments where department_name = 'Analytics';
update employees set salary = salary * 1.1 where department_id = 60;
select sum(salary) from employees where department_id = 60;
delete from departments where department_name = 'Analytics';
merge into jobs j using (select 'AD_PRES' job_id, 45000 max_salary from dual union all select 'NEW_JOB', 9000 from dual) s on (j.job_id = s.job_id) when matched then update set j.max_salary = s.max_salary when not matched then insert (job_id, job_title, min_salary, max_salary) values (s.job_id, 'New Job', 1000, s.max_salary);
select job_id, job_title, max_salary from jobs where job_id in ('AD_PRES', 'NEW_JOB') order by job_id;
rollback;
select sum(salary) from employees where department_id = 60;
