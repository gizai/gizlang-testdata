type Choice =
    | { kind: "Number"; value0: i64; }
    | { kind: "Pair"; value0: Point; value1: f64; }
    | { kind: "Empty";  }
;

type Point = {
    x: i64,
    y: i64,
}

function main(): i64
{
    return read(Choice.Pair(Point(20, 22), 1.0));
}

function read(c: Choice): i64
{
    match (c) {
        Choice.Number(x) => {
            return x;
        }
        Choice.Pair(p, weight) => {
            return ((p).x + (p).y);
        }
        Choice.Empty() => {
            return 0;
        }
    }
}
