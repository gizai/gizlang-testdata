// As js-framework-benchmark's keyed solid implementation.
import { createSignal, createSelector, batch, For } from "solid-js";
import { labels, resumed } from "../../labels.js";

const signals = (rows) => rows.map((r) => { const [label, setLabel] = createSignal(r.label); return { id: r.id, label, setLabel }; });
const build = (n) => signals(labels(n));

/** The rows to start with: none, or those a server rendered (ssr.js). */
export function App(props) {
  const [data, setData] = createSignal(signals(resumed(props.initial || [])));
  const [selected, setSelected] = createSignal(0);
  const isSelected = createSelector(selected);
  const run = () => setData(build(1000));
  const runLots = () => setData(build(10000));
  const add = () => setData((d) => [...d, ...build(1000)]);
  const update = () => batch(() => { const d = data(); for (let i = 0; i < d.length; i += 10) d[i].setLabel((l) => l + " !!!"); });
  const clear = () => setData([]);
  const swapRows = () => { const d = data().slice(); if (d.length > 998) { const t = d[1]; d[1] = d[998]; d[998] = t; setData(d); } };
  const remove = (id) => setData((d) => { const i = d.findIndex((r) => r.id === id); return [...d.slice(0, i), ...d.slice(i + 1)]; });
  return (
    <>
      <div class="jumbotron">
        <button id="run" onClick={run}>Create 1,000 rows</button>
        <button id="runlots" onClick={runLots}>Create 10,000 rows</button>
        <button id="add" onClick={add}>Append 1,000 rows</button>
        <button id="update" onClick={update}>Update every 10th row</button>
        <button id="clear" onClick={clear}>Clear</button>
        <button id="swaprows" onClick={swapRows}>Swap Rows</button>
      </div>
      <table><tbody>
        <For each={data()}>{(row) => {
          const id = row.id;
          return (
            <tr class={isSelected(id) ? "danger" : ""}>
              <td class="col-md-1" textContent={id} />
              <td class="col-md-4"><button onClick={[setSelected, id]} textContent={row.label()} /></td>
              <td class="col-md-1"><button onClick={[remove, id]} aria-label="remove"><span class="glyphicon glyphicon-remove" aria-hidden="true" /></button></td>
              <td class="col-md-6" />
            </tr>
          );
        }}</For>
      </tbody></table>
    </>
  );
}
