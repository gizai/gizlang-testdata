commit;
select count(*), sum(sal), avg(sal), min(hiredate), max(ename) from emp;
select deptno, count(*), sum(sal) from emp group by deptno order by deptno;
select deptno, job, sum(sal) from emp group by rollup(deptno, job) order by deptno, job;
select deptno, job, count(*) from emp group by cube(deptno, job) having count(*) > 2 order by deptno, job;
select deptno, grouping(job), sum(sal) from emp group by grouping sets ((deptno, job), (deptno)) order by 1, 2, 3;
select e.ename, d.dname from emp e, dept d where e.deptno = d.deptno and e.sal > 2900 order by e.ename;
select d.dname, e.ename from dept d, emp e where d.deptno = e.deptno(+) and d.deptno in (10, 40) order by d.dname, e.ename;
select d.dname, count(e.empno) from dept d left join emp e on e.deptno = d.deptno group by d.dname order by d.dname;
select e.ename, m.ename from emp e, emp m where e.mgr = m.empno(+) order by e.ename;
select ename from emp where rownum <= 3 order by ename;
select * from (select ename, sal from emp order by sal desc) where rownum <= 3;
select ename, rownum from (select ename from emp order by ename) where rownum < 4;
select ename from emp where rownum = 2;
select ename, sal from emp order by sal desc, ename fetch first 3 rows only;
select ename, sal from emp order by sal desc, ename offset 2 rows fetch next 2 rows only;
select ename, sal from emp order by sal desc fetch first 2 rows with ties;
select lpad(' ', 2 * (level - 1)) || ename, level from emp start with mgr is null connect by prior empno = mgr order siblings by ename;
select ename, sys_connect_by_path(ename, '/') from emp where level = 3 start with mgr is null connect by prior empno = mgr order by 2;
select ename, connect_by_root ename, connect_by_isleaf from emp where empno in (7369, 7900) start with mgr = 7839 connect by prior empno = mgr order by 1;
select level from dual connect by level <= 4;
select ename, sal, rank() over (order by sal desc), dense_rank() over (order by sal desc), row_number() over (order by sal desc, ename) from emp order by sal desc, ename;
select ename, deptno, sum(sal) over (partition by deptno), sal - avg(sal) over (partition by deptno) from emp order by deptno, ename;
select ename, sal, sum(sal) over (order by hiredate, ename rows between unbounded preceding and current row) from emp order by hiredate, ename;
select ename, lag(ename) over (order by empno), lead(sal, 2, 0) over (order by empno) from emp order by empno;
select deptno, listagg(ename, ',') within group (order by ename) from emp group by deptno order by deptno;
select ename, first_value(ename) over (partition by deptno order by sal desc, ename), ntile(3) over (order by empno) from emp order by empno;
select deptno, max(ename) keep (dense_rank first order by sal desc) from emp group by deptno order by deptno;
select ename, ratio_to_report(sal) over (partition by deptno) from emp where deptno = 10 order by ename;
select percentile_cont(0.5) within group (order by sal), median(sal) from emp;
select ename, nvl(comm, 0) + sal from emp where comm is not null order by ename;
select ename from emp where comm is null and job = 'CLERK' order by ename;
select job from emp where deptno = 10 union select job from emp where deptno = 20 order by 1;
select job from emp where deptno = 10 minus select job from emp where deptno = 20 order by 1;
select job from emp where deptno = 10 intersect select job from emp where deptno = 20 order by 1;
select ename from emp e where sal > (select avg(sal) from emp where deptno = e.deptno) order by ename;
select ename from emp where (deptno, sal) in (select deptno, max(sal) from emp group by deptno) order by ename;
select dname from dept d where not exists (select 1 from emp e where e.deptno = d.deptno);
select ename, case when sal >= 3000 then 'high' when sal >= 1500 then 'mid' else 'low' end from emp order by empno;
with t as (select deptno, sum(sal) s from emp group by deptno) select d.dname, t.s from t join dept d on d.deptno = t.deptno order by t.s;
with r (n) as (select 1 from dual union all select n + 1 from r where n < 5) select sum(n) from r;
select * from (select deptno, job, sal from emp) pivot (sum(sal) for job in ('CLERK' as clerk, 'MANAGER' as manager)) order by deptno;
select * from (select 10 d, 1 a, 2 b from dual) unpivot (v for k in (a, b)) order by k;
select to_char(hiredate, 'YYYY'), count(*) from emp group by to_char(hiredate, 'YYYY') order by 1;
select ename, hiredate from emp where hiredate between date '1981-09-01' and date '1981-12-31' order by hiredate, ename;
select ename from emp where ename like '_A%' order by ename;
select distinct deptno from emp order by deptno desc;
select deptno, sal from emp where deptno = 30 order by comm nulls first, ename;
select deptno, comm from emp where deptno = 30 order by comm desc;
create sequence s1 start with 10 increment by 5;
select s1.nextval from dual;
select s1.nextval, s1.currval from dual;
create table t1 (id number, v varchar2(10));
insert into t1 select empno, ename from emp where deptno = 10;
update t1 set v = lower(v) where id > 7800;
delete from t1 where v = 'king';
merge into t1 t using (select empno, ename from emp where deptno in (10, 40)) s on (t.id = s.empno) when matched then update set t.v = s.ename || '!' when not matched then insert (id, v) values (s.empno, s.ename);
select id, v from t1 order by id;
