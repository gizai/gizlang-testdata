-- Queries over a small HR-like schema: joins, the (+) outer join, ROWNUM, CONNECT BY, analytic
-- functions, grouping, set operators, MERGE and sequences.
create table dept (deptno number(2) primary key, dname varchar2(14), loc varchar2(13));
create table emp (empno number(4) primary key, ename varchar2(10) not null, job varchar2(9), mgr number(4), hiredate date, sal number(7,2), comm number(7,2), deptno number(2) references dept);
