-- The data dictionary views Oracle tools and drivers read.
create table dict_t (id number(10) primary key, name varchar2(20) not null, amount number(8,2), created date);
create index dict_t_name on dict_t (name);
create view dict_v as select id, name from dict_t;
select table_name from user_tables where table_name = 'DICT_T';
select column_name, data_type, data_length, data_precision, data_scale, nullable, column_id from user_tab_columns where table_name = 'DICT_T' order by column_id;
select index_name, uniqueness from user_indexes where table_name = 'DICT_T' and index_name = 'DICT_T_NAME';
select column_name, column_position from user_ind_columns where index_name = 'DICT_T_NAME';
select constraint_type from user_constraints where table_name = 'DICT_T' and constraint_type = 'P';
select view_name from user_views where view_name = 'DICT_V';
select object_name, object_type from user_objects where object_name in ('DICT_T', 'DICT_V', 'DICT_T_NAME') order by 1;
select count(*) from all_tables where table_name = 'DICT_T';
select table_name from user_tab_columns where table_name = 'DICT_V' and column_name = 'NAME';
select comments from user_tab_comments where table_name = 'DICT_T';
select count(*) from dual;
select dummy from dual;
