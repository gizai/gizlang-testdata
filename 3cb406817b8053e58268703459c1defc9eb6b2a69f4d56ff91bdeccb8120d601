>   g_ids num_list := num_list(1, 2, 3);
>   g_names name_map;
>   cursor c_all is select id, name from p3_t order by id;
>   g_count number := 0;
>   function total(p num_list) return number;
>   function doubled(p num_list) return num_list;
>   procedure fill;
>   procedure show;
> end p3_pkg;
.
> create or replace package body p3_pkg is
>   function total(p num_list) return number is
>     s number := 0;
>   begin
>     for i in 1 .. p.count loop s := s + p(i); end loop;
>     return s;
>   end;
>   function doubled(p num_list) return num_list is
>     r num_list := num_list();
>   begin
>     for i in 1 .. p.count loop r.extend; r(r.count) := p(i) * 2; end loop;
>     return r;
>   end;
>   procedure fill is
>   begin
>     g_names('x') := 'ex';
>     g_names('y') := 'why';
>     g_count := g_count + 1;
>   end;
>   procedure show is
>     k varchar2(10);
>   begin
>     k := g_names.first;
>     while k is not null loop
>       insert into p3_log values (g_count, k || '=' || g_names(k));
>       k := g_names.next(k);
>     end loop;
>     for r in c_all loop
>       insert into p3_log values (r.id, r.name);
>     end loop;
>   end;
> end p3_pkg;
.
