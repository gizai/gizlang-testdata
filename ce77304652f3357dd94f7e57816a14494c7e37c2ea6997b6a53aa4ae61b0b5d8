-- Oracle's built-in single-row functions and NULL rules, each against DUAL.
select nvl(null, 'a'), nvl('b', 'a'), nvl2(null, 'x', 'y'), nvl2(1, 'x', 'y') from dual;
select coalesce(null, null, 3), nullif(1, 1), nullif(1, 2) from dual;
select decode(2, 1, 'one', 2, 'two', 'other'), decode(9, 1, 'one', 'other'), decode(null, null, 'nulls match', 'no') from dual;
select decode(3, 1, 'one') from dual;
select case when '' is null then 'null' else 'empty' end from dual;
select length(''), length('abc'), lengthb('abc') from dual;
select 'a' || null || 'b', concat('a', null), concat(null, null) from dual;
select substr('hello', 0, 2), substr('hello', 2), substr('hello', -3), substr('hello', -3, 2), substr('hello', 9) from dual;
select instr('banana', 'an'), instr('banana', 'an', 3), instr('banana', 'an', 1, 2), instr('banana', 'an', -1), instr('banana', 'x') from dual;
select upper('abc'), lower('ABC'), initcap('hello wORLD foo-bar') from dual;
select lpad('7', 3, '0'), rpad('ab', 5, '*'), lpad('abcdef', 3), rpad('x', 0) from dual;
select trim('  x  '), ltrim('xxyx', 'x'), rtrim('yxxx', 'x'), trim(both 'x' from 'xxaxx'), trim(leading '0' from '00120') from dual;
select replace('banana', 'an', 'AN'), replace('banana', 'a'), replace('abc', null, 'x') from dual;
select translate('hello', 'el', 'ip'), translate('a-b-c', 'a-', 'A') from dual;
select chr(65), ascii('A'), ascii('') from dual;
select reverse('abc') from dual;
select abs(-3), sign(-2), sign(0), ceil(2.1), floor(-2.1), round(2.5), round(-2.5), round(1.2345, 2), round(1234.5, -2) from dual;
select trunc(2.789, 1), trunc(-2.7), trunc(1234, -2), mod(7, 3), mod(-7, 3), mod(7, -3), mod(7, 0), remainder(7, 3) from dual;
select power(2, 10), sqrt(16), exp(0), ln(1), log(10, 1000) from dual;
select greatest(1, 3, 2), least('b', 'a', 'c'), greatest(1, null, 3) from dual;
select 7 / 2, 1 / 3 * 3, 10 / 4, -7 / 2 from dual;
select to_char(1234.5, '9,999.99'), to_char(0.5, '0.00'), to_char(42), to_char(-1.5), to_char(1234567, '999,999,999') from dual;
select to_char(5, '000'), to_char(123.456, 'FM999.9'), to_char(0.1) from dual;
select to_number('42'), to_number('1,234.50', '9,999.99'), to_number(' 12 ') from dual;
select to_number('abc') from dual;
select to_date('2024-03-01', 'YYYY-MM-DD') - to_date('2024-02-28', 'YYYY-MM-DD') from dual;
select to_char(to_date('2024-03-05 14:07:09', 'YYYY-MM-DD HH24:MI:SS'), 'YYYY/MM/DD HH24:MI:SS') from dual;
select to_char(date '2024-03-05', 'DD-MON-YYYY'), to_char(date '2024-03-05', 'Mon DD, YYYY'), to_char(date '2024-03-05', 'DY DAY D DDD') from dual;
select to_char(date '2024-03-05', 'Q WW IW J') from dual;
select to_char(to_date('2024-03-05 09:07', 'YYYY-MM-DD HH24:MI'), 'HH:MI AM') from dual;
select add_months(date '2024-01-31', 1), add_months(date '2024-03-15', -2), last_day(date '2024-02-10') from dual;
select months_between(date '2024-03-31', date '2024-01-31'), months_between(date '2024-03-15', date '2024-01-01') from dual;
select next_day(date '2024-03-05', 'MONDAY') from dual;
select trunc(to_date('2024-03-05 14:07', 'YYYY-MM-DD HH24:MI')), trunc(date '2024-03-05', 'MM'), trunc(date '2024-03-05', 'YYYY'), trunc(date '2024-08-05', 'Q') from dual;
select round(to_date('2024-03-05 14:07', 'YYYY-MM-DD HH24:MI')), round(date '2024-03-20', 'MM') from dual;
select date '2024-03-05' + 1, date '2024-03-05' - 1, date '2024-03-05' + 0.5 from dual;
select extract(year from date '2024-03-05'), extract(month from date '2024-03-05'), extract(day from date '2024-03-05') from dual;
select to_date('31-12-2024', 'DD-MM-YYYY') from dual;
select to_date('2024-02-30', 'YYYY-MM-DD') from dual;
select timestamp '2024-03-05 10:00:00' + interval '1' day from dual;
select date '2024-03-05' + interval '2' month from dual;
select cast('12' as number) + 1, cast(3.7 as integer), cast(date '2024-03-05' as varchar2(30)) from dual;
select cast('2024-03-05' as date) from dual;
select '5' + 3, '2' * '4' from dual;
select 1 from dual where '' = '';
select 1 from dual where null is null;
select regexp_substr('abc123def', '[0-9]+'), regexp_instr('abc123', '[0-9]'), regexp_replace('a1b2', '[0-9]', '#'), regexp_count('banana', 'a') from dual;
select regexp_substr('a,b,c', '[^,]+', 1, 2) from dual;
select 1 from dual where regexp_like('Hello', '^h', 'i');
select lnnvl(1 = 2), lnnvl(null = 1) from dual;
select bitand(12, 10) from dual;
select vsize('abc'), dump('ab') from dual;
select soundex('Robert') from dual;
select width_bucket(5, 0, 10, 5) from dual;
select nanvl(1, 2) from dual;
select sys_guid() is not null from dual;
select ora_hash('x') >= 0 from dual;
select userenv('LANGUAGE') is not null from dual;
select 1 from dual where 'abc' like 'a%';
select 1 from dual where 'ABC' like 'a%';
select 1 from dual where 'a_c' like 'a\_c' escape '\';
select 'O''Brien', q'[it's]' from dual;
select N'unicode' from dual;
select 1e3, 1.5e-2, .5, 5. from dual;
select binary_double_nan is nan from dual;
