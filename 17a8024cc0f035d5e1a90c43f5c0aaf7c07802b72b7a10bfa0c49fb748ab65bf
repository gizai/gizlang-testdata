body{font:15px/1.5 system-ui,sans-serif;max-width:44rem;margin:2rem auto;padding:0 1rem;color:#1d1d1f}h1{font-size:1.25rem}ol{list-style:none;padding:0}li{border-top:1px solid #e5e5ea;padding:.6rem 0}li li{margin-left:1.5rem;border-top:0;padding:.3rem 0}ol ol:empty{display:none}header{color:#6e6e73;font-size:13px;display:flex;gap:.5rem;align-items:center}p{margin:.25rem 0;white-space:pre-wrap}form{display:flex;flex-direction:column;gap:.4rem;margin:.4rem 0}form.inline{display:inline;margin:0 0 0 auto}form.inline button{border:0;background:none;color:#86868b;padding:0;font-size:13px;cursor:pointer}form.inline button:hover{color:#d70015}label span{display:block;font-size:13px;color:#6e6e73}textarea{width:100%;box-sizing:border-box;min-height:4rem;font:inherit;padding:.4rem;border:1px solid #d2d2d7;border-radius:6px}button{align-self:flex-start;font:inherit;padding:.2rem .8rem}.err{color:#d70015}details summary{cursor:pointer;color:#0066cc;font-size:13px}.gone{color:#86868b;font-style:italic}.who{color:#6e6e73;font-size:13px}
