interface Score {
    score(self: Self): i64 effects {fail};
}

type Entry = {
    value: i64,
}

function Entry.score(self: Entry): i64
{
    return ((self).value + 1);
}

function program(): i64
{
    return score(Entry(41));
}

function score<T extends Score>(x: T): i64
{
    return (x).score();
}
function main(): void { print(string(program())); }
