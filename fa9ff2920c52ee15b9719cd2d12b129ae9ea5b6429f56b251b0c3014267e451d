create or replace package p2_pkg is
  counter number := 0;
  function bump return number;
  procedure bump(n number);
  function describe(x number) return varchar2;
  function describe(x varchar2) return varchar2;
  c_limit constant number := 100;
end p2_pkg;
/
create or replace package body p2_pkg is
  function bump return number is begin counter := counter + 1; return counter; end;
  procedure bump(n number) is begin counter := counter + n; end;
  function describe(x number) return varchar2 is begin return 'num ' || x; end;
  function describe(x varchar2) return varchar2 is begin return 'str ' || x; end;
end p2_pkg;
/
select p2_pkg.bump from dual;
begin p2_pkg.bump(10); end;
/
select p2_pkg.bump from dual;
select p2_pkg.describe(5), p2_pkg.describe('a') from dual;
create or replace function p2_ref(d number) return sys_refcursor is
  rc sys_refcursor;
begin
  open rc for select id, name from p2_emp where dept = d order by id;
  return rc;
end;
/
declare
  rc sys_refcursor; v_id number; v_name varchar2(30);
begin
  rc := p2_ref(10);
  loop fetch rc into v_id, v_name; exit when rc%notfound; insert into p2_log values (v_id, v_name); end loop;
  close rc;
end;
/
