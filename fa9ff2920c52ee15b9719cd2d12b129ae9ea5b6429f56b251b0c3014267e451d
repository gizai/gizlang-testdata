delete from p2_log;
create or replace procedure p2_out(a number, b out number, c in out number) is
begin b := a * 2; c := c + a; end;
/
declare
  x number; y number := 5;
begin
  p2_out(3, x, y);
  insert into p2_log values (x, 'out');
  insert into p2_log values (y, 'inout');
end;
