create table p2_audit (op varchar2(10), id number, old_sal number, new_sal number);
create or replace trigger p2_trg_row after insert or update or delete on p2_emp
for each row
begin
  if inserting then insert into p2_audit values ('I', :new.id, null, :new.sal);
  elsif updating then insert into p2_audit values ('U', :new.id, :old.sal, :new.sal);
  else insert into p2_audit values ('D', :old.id, :old.sal, null);
  end if;
end;
/
