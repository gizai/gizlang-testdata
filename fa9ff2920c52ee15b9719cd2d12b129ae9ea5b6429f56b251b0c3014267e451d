declare
  type t_ids is table of number;
  ids t_ids; c number; r number;
begin
  select id bulk collect into ids from p2_emp where dept >= 20 order by id;
  c := ids.count;
  insert into p2_log values (c, 'bulk');
  forall i in 1 .. ids.count
    update p2_emp set sal = sal + 1 where id = ids(i);
  r := sql%rowcount;
  insert into p2_log values (r, 'forall');
end;
/
