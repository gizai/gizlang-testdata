declare
  e_neg exception;
  pragma exception_init(e_neg, -20100);
  c number; m varchar2(200);
begin
  raise_application_error(-20100, 'negative');
exception
  when e_neg then c := sqlcode; m := sqlerrm; insert into p2_log values (c, m);
end;
/
select n, msg from p2_log;
delete from p2_log;
declare
  e_mine exception;
begin
  begin
    raise e_mine;
  exception
    when e_mine then insert into p2_log values (1, 'inner'); raise;
  end;
exception
  when others then insert into p2_log values (2, 'outer');
end;
