declare
  i number := 0;
begin
  loop
    i := i + 1;
    continue when mod(i, 2) = 0;
    exit when i > 7;
    insert into p2_log values (i, 'odd');
  end loop;
  while i > 5 loop i := i - 1; end loop;
  insert into p2_log values (i, 'end');
  for j in reverse 1 .. 3 loop insert into p2_log values (j, 'rev'); end loop;
end;
/
select n, msg from p2_log order by msg, n;
delete from p2_log;
declare
  g varchar2(10);
  n number := 15;
begin
  g := case when n > 10 then 'big' when n > 5 then 'mid' else 'small' end;
  case g
    when 'big' then insert into p2_log values (1, 'big');
    when 'mid' then insert into p2_log values (2, 'mid');
    else insert into p2_log values (3, 'other');
  end case;
end;
