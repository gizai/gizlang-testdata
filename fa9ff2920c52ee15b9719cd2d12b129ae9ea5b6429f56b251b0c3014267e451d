declare
  v number; r number;
begin
  execute immediate 'select count(*) from p2_emp where dept = :d' into v using 10;
  insert into p2_log values (v, 'dyn');
  execute immediate 'insert into p2_log values (:1, :2)' using 99, 'dml';
  execute immediate 'update p2_emp set dept = dept where id = :1' using 1;
  r := sql%rowcount;
  insert into p2_log values (r, 'dynrows');
end;
/
