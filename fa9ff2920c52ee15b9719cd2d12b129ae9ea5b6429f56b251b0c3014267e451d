declare
  type t_nums is table of number;
  v t_nums := t_nums(10, 20, 30);
  c number; f number; l number;
begin
  v.extend; v(4) := 40;
  c := v.count; f := v.first; l := v.last;
  insert into p2_log values (c, 'count');
  for i in 1 .. v.count loop
    insert into p2_log values (v(i), 'item' || i);
  end loop;
  insert into p2_log values (f, 'first');
  insert into p2_log values (l, 'last');
end;
/
select n, msg from p2_log order by msg;
delete from p2_log;
declare
  type t_map is table of number index by varchar2(10);
  m t_map;
  k varchar2(10); ea number; ez number;
begin
  m('b') := 2; m('a') := 1; m('c') := 3;
  k := m.first;
  while k is not null loop
    insert into p2_log values (m(k), k);
    k := m.next(k);
  end loop;
  if m.exists('a') then ea := 1; else ea := 0; end if;
  if m.exists('z') then ez := 1; else ez := 0; end if;
  insert into p2_log values (ea, 'exists a');
  insert into p2_log values (ez, 'exists z');
end;
/
select n, msg from p2_log order by msg;
delete from p2_log;
declare
  type t_va is varray(3) of varchar2(5);
  v t_va := t_va('x', 'y');
  c number; l number;
begin
  c := v.count; l := v.limit;
  insert into p2_log values (c, 'count');
  insert into p2_log values (l, 'limit');
end;
/
select n, msg from p2_log order by msg;
