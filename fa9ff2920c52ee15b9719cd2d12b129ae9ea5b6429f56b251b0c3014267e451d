-- PL/SQL beyond the basics: cursors, records, collections, bulk operations, dynamic SQL, exceptions, packages and triggers.
create table p2_emp (id number primary key, name varchar2(30), dept number, sal number(8,2));
insert into p2_emp values (1, 'ann', 10, 1000);
insert into p2_emp values (2, 'bob', 10, 2000);
insert into p2_emp values (3, 'cy', 20, 3000);
insert into p2_emp values (4, 'di', 20, 4000);
insert into p2_emp values (5, 'ed', 30, 5000);
create table p2_log (n number, msg varchar2(200));
declare
  cursor c is select id, name from p2_emp order by id;
  v_id number; v_name varchar2(30); v_rc number;
begin
  open c;
  loop
    fetch c into v_id, v_name;
    exit when c%notfound;
    v_rc := c%rowcount;
    insert into p2_log values (v_id, v_name || ':' || v_rc);
  end loop;
  close c;
end;
/
select n, msg from p2_log order by n;
delete from p2_log;
declare
  cursor c(p_dept number) is select name, sal from p2_emp where dept = p_dept order by id;
begin
  for r in c(20) loop
    insert into p2_log values (r.sal, r.name);
  end loop;
end;
/
select n, msg from p2_log order by n;
delete from p2_log;
declare
  r p2_emp%rowtype;
begin
  select * into r from p2_emp where id = 3;
