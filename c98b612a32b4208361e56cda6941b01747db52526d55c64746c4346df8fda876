function testHiddenPayReleasesHeld(): void {
    let d = hiddenMust(placeOrder(hiddenDepot(), "tiny", "A", hiddenOne("NUT", 80)));
    d = hiddenMust(ship(d, 1));
    // tiny owes 800 of 1000: 300 more is held, and 225 more is held too.
    d = hiddenMust(placeOrder(d, "tiny", "A", hiddenOne("NUT", 30)));
    d = hiddenMust(placeOrder(d, "tiny", "A", hiddenOne("BOLT", 9)));
    const held = statusOf(d, 2) === "onHold" && statusOf(d, 3) === "onHold" && hiddenJoin(openTasks(d)) === "credit:tiny";
    d = hiddenMust(pay(d, 1));
    // Paid: 300 fits, then 300 + 225 fits too; no held order is left.
    HiddenTest.check(held && owedBy(d, "tiny") === 0 && statusOf(d, 2) === "placed" && statusOf(d, 3) === "placed"
        && hiddenJoin(openTasks(d)) === "" && hiddenFailed(pay(d, 1)) && hiddenFailed(pay(d, 2))
        && statement(d, "tiny") === "#1 1 800 paid\nowed 0\n");
}
function testHiddenReleaseOldestFirst(): void {
    let d = hiddenMust(placeOrder(hiddenDepot(), "tiny", "A", hiddenOne("NUT", 90)));
    d = hiddenMust(ship(d, 1));
    d = hiddenMust(placeOrder(d, "tiny", "A", hiddenOne("NUT", 70)));
    d = hiddenMust(placeOrder(d, "tiny", "A", hiddenOne("NUT", 20)));
    d = hiddenMust(placeOrder(d, "tiny", "A", hiddenOne("NUT", 40)));
    d = hiddenMust(pay(d, 1));
    // 700 fits, 700 + 200 fits, then 400 more does not and stays held.
    HiddenTest.check(statusOf(d, 2) === "placed" && statusOf(d, 3) === "placed" && statusOf(d, 4) === "onHold"
        && hiddenJoin(openTasks(d)) === "credit:tiny");
}
