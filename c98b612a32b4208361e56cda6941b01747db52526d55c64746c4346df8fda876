function testHiddenPlaceReserves(): void {
    const d = hiddenMust(placeOrder(hiddenDepot(), "acme", "B", hiddenTwo("BOLT", 150, "GEAR", 3)));
    HiddenTest.check(lastOrderId(d) === 1 && statusOf(d, 1) === "placed" && statusOf(d, 2) === "" && stockAt(d, "BOLT", "B") === 50
