    HiddenTest.check(hiddenFailed(placeOrder(d, "nobody", "A", hiddenOne("BOLT", 1))) && hiddenFailed(placeOrder(d, "acme", "A", none))
        && hiddenFailed(placeOrder(d, "acme", "A", hiddenOne("BOLT", 0))) && hiddenFailed(placeOrder(d, "acme", "A", hiddenOne("NOPE", 1)))
