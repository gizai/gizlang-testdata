}
function testHiddenCancelReturnsStock(): void {
    let d = hiddenMust(placeOrder(hiddenDepot(), "acme", "B", hiddenOne("GEAR", 9)));
    d = hiddenMust(cancel(d, 1));
    HiddenTest.check(statusOf(d, 1) === "cancelled" && stockAt(d, "GEAR", "B") === 10 && hiddenFailed(cancel(d, 1))
