namespace lib {
    export function f(x: i64): i64
    {
        const g = (v: i64): i64 => {
        return secret(v);
    };
        return g(x);
    }
    
    function secret(x: i64): i64
    {
        return (x + 1);
    }
    
}

function program(): i64
{
    return lib__f(41);
}
function main(): void { print(string(program())); }
