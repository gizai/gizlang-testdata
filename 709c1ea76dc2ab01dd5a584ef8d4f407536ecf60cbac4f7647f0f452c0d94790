function matvec(a: View<f64>, x: View<f64>, out: MutableView<f64>, rows: i64, cols: i64): i64
requires (rows >= 0)
requires (cols >= 0)
requires (len(a) === (rows * cols))
requires (len(x) === cols)
requires (len(out) === rows)
{
    for (const r of range(0, rows)) {
        let total = 0.0;
        for (const c of range(0, cols)) {
            total = (total + (a[((r * cols) + c)] * x[c]));
        }
        out[r] = total;
    }
    return rows;
}
