CREATE SEQUENCE ticket_seq START 100 INCREMENT 5;
CREATE TABLE customers (
    id integer PRIMARY KEY,
    name text NOT NULL,
    email text UNIQUE,
    balance numeric(12,2) DEFAULT 0,
    born date,
    active boolean DEFAULT true
);
CREATE TABLE orders (
    id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    customer_id integer NOT NULL REFERENCES customers (id),
    placed timestamp,
    note text,
    total double precision
);
CREATE INDEX orders_customer_idx ON orders (customer_id);
CREATE TABLE tickets (
    id integer PRIMARY KEY DEFAULT nextval('ticket_seq'),
    body text
);
CREATE VIEW big_orders AS SELECT o.id, c.name, o.total FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.total > 50;
